+
+// MARK: - Vanta home
+
+/// The new tab, as on desktop Vanta: true black, the date and tonight's moon in small spaced
+/// capitals, and the search set large like a page heading. Below lies a planet's horizon with
+/// the sun on it by the time of day: warm at dawn and dusk, white by day, only a moonlit rim at
+/// night. Arriving plays one sunrise; afterwards nothing moves. Only transform and opacity animate.
+final class VantaHomeView: UIView {
+    private enum Sky {
+        case dawn, day, dusk, night
+
+        init(hour: Double) {
+            switch hour {
+            case ..<6, 20...: self = .night
+            case ..<9: self = .dawn
+            case ..<17: self = .day
+            default: self = .dusk
+            }
+        }
+
+        var glow: UIColor {
+            switch self {
+            case .dawn: return UIColor(red: 1, green: 168 / 255, blue: 110 / 255, alpha: 1)
+            case .dusk: return UIColor(red: 1, green: 140 / 255, blue: 96 / 255, alpha: 1)
+            case .day: return UIColor(red: 190 / 255, green: 210 / 255, blue: 1, alpha: 1)
+            case .night: return UIColor(red: 170 / 255, green: 185 / 255, blue: 215 / 255, alpha: 1)
+            }
+        }
+
+        var sun: UIColor {
+            switch self {
+            case .dawn: return UIColor(red: 1, green: 226 / 255, blue: 190 / 255, alpha: 1)
+            case .dusk: return UIColor(red: 1, green: 214 / 255, blue: 170 / 255, alpha: 1)
+            case .day, .night: return .white
+            }
+        }
+
+        var sunX: CGFloat {
+            switch self {
+            case .dawn: return 0.22
+            case .dusk: return 0.70
+            case .day, .night: return 0.34
+            }
+        }
+
+        var sunSize: CGFloat {
+            switch self {
+            case .dawn, .dusk: return 0.9
+            case .day: return 1
+            case .night: return 0
+            }
+        }
+    }
+
+    private static let horizon: CGFloat = 0.74
+
+    private let onSearch: () -> Void
+    private let planet = CAShapeLayer()
+    private let rim = CAShapeLayer()
+    private let sun = CAGradientLayer()
+    private let glare = CAGradientLayer()
+    private let content = UIView()
+    private let moon = VantaMoonView()
+    private let dateLabel = UILabel()
+    private let searchLabel = UILabel()
+    private var sky = Sky.day
+
+    init(onSearch: @escaping () -> Void) {
+        self.onSearch = onSearch
+        super.init(frame: .zero)
+        backgroundColor = .black
+        clipsToBounds = true
+
+        sun.type = .radial
+        glare.type = .radial
+        rim.shadowOffset = CGSize(width: 0, height: -6)
+        rim.shadowRadius = 15
+        planet.fillColor = UIColor.black.cgColor
+        for sublayer in [sun, glare, rim, planet] as [CALayer] {
+            layer.addSublayer(sublayer)
+        }
+
+        dateLabel.numberOfLines = 1
+        searchLabel.numberOfLines = 0
+        searchLabel.isAccessibilityElement = true
+        searchLabel.accessibilityTraits = .searchField
+
+        let dateRow = UIStackView(arrangedSubviews: [moon, dateLabel, UIView()])
+        dateRow.axis = .horizontal
+        dateRow.alignment = .center
+        dateRow.spacing = 10
+        let column = UIStackView(arrangedSubviews: [dateRow, searchLabel])
+        column.axis = .vertical
+        column.alignment = .fill
+        column.spacing = 18
+        column.translatesAutoresizingMaskIntoConstraints = false
+        content.translatesAutoresizingMaskIntoConstraints = false
+        content.addSubview(column)
+        addSubview(content)
+        NSLayoutConstraint.activate([
+            content.topAnchor.constraint(equalTo: topAnchor),
+            content.leadingAnchor.constraint(equalTo: leadingAnchor),
+            content.trailingAnchor.constraint(equalTo: trailingAnchor),
+            content.bottomAnchor.constraint(equalTo: bottomAnchor),
+            column.leadingAnchor.constraint(equalTo: content.readableContentGuide.leadingAnchor, constant: 12),
+            column.trailingAnchor.constraint(equalTo: content.readableContentGuide.trailingAnchor),
+            column.topAnchor.constraint(equalTo: content.safeAreaLayoutGuide.topAnchor, constant: 72),
+            moon.widthAnchor.constraint(equalToConstant: 14),
+            moon.heightAnchor.constraint(equalToConstant: 14),
+        ])
+
+        addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(search)))
+        update()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc
+    private func search() {
+        onSearch()
+    }
+
+    /// Night, dawn, day or dusk from the clock; the date; the moon's phase.
+    func update(now: Date = Date()) {
+        let calendar = Calendar.current
+        let hour = Double(calendar.component(.hour, from: now)) + Double(calendar.component(.minute, from: now)) / 60
+        sky = Sky(hour: hour)
+
+        let date = now.formatted(.dateTime.weekday(.wide).day().month(.wide)).uppercased()
+        dateLabel.attributedText = NSAttributedString(string: date, attributes: [
+            .font: UIFont.systemFont(ofSize: 12, weight: .semibold),
+            .kern: 12 * 0.18,
+            .foregroundColor: UIColor.white.withAlphaComponent(0.5),
+        ])
+        searchLabel.attributedText = NSAttributedString(string: .VantaHomeSearch, attributes: [
+            .font: UIFont.systemFont(ofSize: 40, weight: .semibold),
+            .kern: -40 * 0.035,
+            .foregroundColor: UIColor.white.withAlphaComponent(0.2),
+        ])
+        searchLabel.accessibilityLabel = .VantaHomeSearch
+
+        // Days into the lunar month, from a known new moon (6 Jan 2000, 18:14 UTC).
+        let newMoon = Date(timeIntervalSince1970: 947_182_440)
+        let phase = (now.timeIntervalSince(newMoon) / 86_400 / 29.530588).truncatingRemainder(dividingBy: 1)
+        moon.phase = phase
+        setNeedsLayout()
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let w = bounds.width, h = bounds.height
+        guard w > 0, h > 0 else { return }
+        let horizonY = h * Self.horizon
+
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        // The planet: a body far wider than the screen, lit along its upper rim.
+        let d = w * 4.2
+        let planetRect = CGRect(x: w / 2 - d / 2, y: horizonY, width: d, height: d)
+        planet.path = UIBezierPath(ovalIn: planetRect).cgPath
+        rim.path = UIBezierPath(ovalIn: planetRect.offsetBy(dx: 0, dy: -1)).cgPath
+        rim.shadowPath = rim.path
+        let glow = sky.glow
+        rim.fillColor = glow.withAlphaComponent(sky == .night ? 0.45 : 0.55).cgColor
+        rim.shadowColor = glow.cgColor
+        rim.shadowOpacity = sky == .night ? 0.2 : 0.3
+
+        // The sun on the horizon: a point, its glare along the rim and a wide halo.
+        let sunColor = sky.sun
+        let sunCenter = CGPoint(x: w * sky.sunX, y: horizonY)
+        sun.frame = CGRect(x: sunCenter.x - 450, y: sunCenter.y - 170, width: 900, height: 340)
+        sun.colors = [
+            sunColor, sunColor, sunColor.withAlphaComponent(0.55),
+            glow.withAlphaComponent(0.22), glow.withAlphaComponent(0.06), glow.withAlphaComponent(0),
+        ].map(\.cgColor)
+        sun.locations = [0, 0.011, 0.03, 0.14, 0.45, 1]
+        sun.startPoint = CGPoint(x: 0.5, y: 0.5)
+        sun.endPoint = CGPoint(x: 1, y: 1)
+        glare.frame = CGRect(x: sunCenter.x - 225, y: sunCenter.y - 4.25, width: 450, height: 8.5)
+        glare.colors = [sunColor.withAlphaComponent(0.55), sunColor.withAlphaComponent(0)].map(\.cgColor)
+        glare.startPoint = CGPoint(x: 0.5, y: 0.5)
+        glare.endPoint = CGPoint(x: 1, y: 1)
+        [sun, glare].forEach {
+            $0.transform = CATransform3DMakeScale(max(sky.sunSize, 0.001), max(sky.sunSize, 0.001), 1)
+            $0.opacity = Float(sky.sunSize)
+        }
+        CATransaction.commit()
+    }
+
+    /// Each arrival is a new sunrise, played once.
+    func arrive() {
+        update()
+        layoutIfNeeded()
+        guard !UIAccessibility.isReduceMotionEnabled else { return }
+
+        let rise = CASpringAnimation(keyPath: "transform.translation.y")
+        rise.fromValue = 70
+        rise.toValue = 0
+        rise.damping = 30
+        rise.stiffness = 60
+        rise.duration = 1.5
+        let fade = CABasicAnimation(keyPath: "opacity")
+        fade.fromValue = 0.25
+        fade.duration = 1.2
+        fade.timingFunction = CAMediaTimingFunction(controlPoints: 0.16, 1, 0.3, 1)
+        [planet, rim].forEach {
+            $0.add(rise, forKey: "vanta.rise")
+            $0.add(fade, forKey: "vanta.fade")
+        }
+
+        let sunrise = CABasicAnimation(keyPath: "transform")
+        sunrise.fromValue = NSValue(caTransform3D: CATransform3DConcat(
+            CATransform3DMakeScale(sky.sunSize * 0.35 + 0.001, sky.sunSize * 0.35 + 0.001, 1),
+            CATransform3DMakeTranslation(0, 60, 0)
+        ))
+        sunrise.duration = 1.7
+        sunrise.beginTime = CACurrentMediaTime() + 0.15
+        sunrise.fillMode = .backwards
+        sunrise.timingFunction = CAMediaTimingFunction(controlPoints: 0.2, 1, 0.3, 1)
+        [sun, glare].forEach { $0.add(sunrise, forKey: "vanta.sunrise") }
+
+        content.alpha = 0
+        content.transform = CGAffineTransform(translationX: 0, y: 10)
+        UIView.animate(withDuration: 0.9, delay: 0.25, options: [.curveEaseOut, .allowUserInteraction]) {
+            self.content.alpha = 1
+            self.content.transform = .identity
+        }
+    }
+}
+
+/// The moon as it is tonight: lit from the sun's side, the rest in shadow.
+final class VantaMoonView: UIView {
+    var phase: Double = 0 {
+        didSet { setNeedsDisplay() }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        isOpaque = false
+        isAccessibilityElement = false
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func draw(_ rect: CGRect) {
+        guard let context = UIGraphicsGetCurrentContext() else { return }
+        let disc = bounds.insetBy(dx: 0.5, dy: 0.5)
+        context.saveGState()
+        context.addEllipse(in: disc)
+        context.clip()
+        let colors = [UIColor.white.cgColor, UIColor(red: 0.81, green: 0.83, blue: 0.86, alpha: 1).cgColor] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0, 1]) {
+            let start = CGPoint(x: disc.minX + disc.width * 0.35, y: disc.minY + disc.height * 0.3)
+            context.drawRadialGradient(
+                gradient,
+                startCenter: start,
+                startRadius: 0,
+                endCenter: start,
+                endRadius: disc.width * 0.7,
+                options: .drawsAfterEndLocation
+            )
+        }
+        // Waxing is lit from the right, waning from the left: a shadow disc slides across.
+        let lit = CGFloat(1 - abs(1 - 2 * phase))
+        let side: CGFloat = phase < 0.5 ? -1 : 1
+        context.setFillColor(UIColor.black.cgColor)
+        context.fillEllipse(in: disc.offsetBy(dx: side * disc.width * lit, dy: 0))
+        context.restoreGState()
+        context.setStrokeColor(UIColor.white.withAlphaComponent(0.12).cgColor)
+        context.setLineWidth(1)
+        context.strokeEllipse(in: disc)
+    }
+}
+
+extension String {
+    static let VantaHomeSearch = "Search or enter address"
+}
