@@ -92,6 +92,8 @@ class AppDelegate: UIResponder,
         // Then setup dependency container as it's needed for everything else
         DependencyHelper().bootstrapDependencies()
 
+        VantaDefaults.apply(to: profile.prefs)
+
         appLaunchUtil = AppLaunchUtil(profile: profile)
         appLaunchUtil?.setUpPreLaunchDependencies()
 
@@ -472,3 +474,26 @@ extension AppDelegate {
         return configuration
     }
 }
+
+// MARK: - Vanta
+
+/// Vanta's defaults, written once on first launch so later choices in Settings stick:
+/// no usage data or studies sent to Mozilla, ads blocked, no sponsored or trending
+/// suggestions, and no Firefox onboarding.
+enum VantaDefaults {
+    static let appliedKey = "vanta.defaultsApplied"
+    static let asksForMozillaTerms = false
+
+    static func apply(to prefs: Prefs) {
+        guard prefs.boolForKey(appliedKey) != true else { return }
+        prefs.setBool(false, forKey: AppConstants.prefSendUsageData)
+        prefs.setBool(false, forKey: AppConstants.prefSendCrashReports)
+        prefs.setBool(false, forKey: AppConstants.prefStudiesToggle)
+        prefs.setBool(true, forKey: PrefsKeys.BlockAds)
+        prefs.setBool(true, forKey: ContentBlockingConfig.Prefs.EnabledKey)
+        prefs.setBool(false, forKey: PrefsKeys.SearchSettings.showFirefoxSponsoredSuggestions)
+        prefs.setBool(false, forKey: PrefsKeys.SearchSettings.showTrendingSearches)
+        prefs.setInt(1, forKey: PrefsKeys.IntroSeen)
+        prefs.setBool(true, forKey: appliedKey)
+    }
+}
