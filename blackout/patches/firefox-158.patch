+// Vanta Blackout: substring search for the short needles and haystacks of URL
+// matching. `memchr::memmem::find` builds a searcher on every call, which costs
+// more than it saves at these sizes and made it the single biggest cost of a
+// request check.
+#[inline]
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    let Some((&first, rest)) = needle.split_first() else {
+        return Some(0);
+    };
+    if needle.len() > haystack.len() {
+        return None;
+    }
+    let last_start = haystack.len() - needle.len();
+    let mut i = 0;
+    while let Some(offset) = memchr::memchr(first, &haystack[i..=last_start]) {
+        let pos = i + offset;
+        if &haystack[pos + 1..pos + needle.len()] == rest {
+            return Some(pos);
+        }
+        i = pos + 1;
+        if i > last_start {
+            break;
+        }
+    }
+    None
+}
 
