+NS_IMETHODIMP ContentClassifierService::GetCosmeticStyle(
+    const nsACString& aFeatureName, const nsACString& aUrl,
+    bool aIncludeGeneric, JSContext* aCx, dom::Promise** aPromise) {
+  NS_ENSURE_ARG_POINTER(aPromise);
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+
+  RefPtr<dom::Promise> promise;
+  nsresult rv = MakeProbePromise(aCx, getter_AddRefs(promise));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  RefPtr<ContentClassifierEngine> engine;
+  {
+    MutexAutoLock lock(mLock);
+    if (auto entry = mEngines.Lookup(nsCString(aFeatureName))) {
+      engine = entry.Data();
+    }
+  }
+  if (!engine) {
+    promise->MaybeResolve(nsString());
+    promise.forget(aPromise);
+    return NS_OK;
+  }
+
+  nsMainThreadPtrHandle<dom::Promise> promiseHolder(
+      new nsMainThreadPtrHolder<dom::Promise>(
+          "ContentClassifierService::GetCosmeticStyle promise", promise));
+
+  // Engines are only ever used on the URL classifier thread, which is also
+  // where network requests are checked against them.
+  nsIThread* backgroundThread = nsUrlClassifierDBService::BackgroundThread();
+  if (backgroundThread) {
+    rv = backgroundThread->Dispatch(
+        NS_NewRunnableFunction(
+            "ContentClassifierService::GetCosmeticStyle",
+            [engine = std::move(engine), url = nsCString(aUrl), aIncludeGeneric,
+             promiseHolder]() {
+              nsCString css;
+              if (NS_FAILED(
+                      engine->GetCosmeticCss(url, aIncludeGeneric, css))) {
+                css.Truncate();
+              }
+              NS_DispatchToMainThread(NS_NewRunnableFunction(
+                  "ContentClassifierService::GetCosmeticStyle resolve",
+                  [promiseHolder, css = std::move(css)]() {
+                    promiseHolder->MaybeResolve(NS_ConvertUTF8toUTF16(css));
+                  }));
+            }),
+        NS_DISPATCH_NORMAL);
+  } else {
+    rv = NS_ERROR_NOT_INITIALIZED;
+  }
+  if (NS_FAILED(rv)) {
+    promise->MaybeReject(rv);
+  }
+  promise.forget(aPromise);
+  return NS_OK;
+}
