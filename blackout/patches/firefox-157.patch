+// Vanta Blackout: runs aGetCss with aEngine on the URL classifier thread, the
+// only thread engines are used on, and resolves aPromise with the style sheet
+// it writes. A failure resolves with an empty sheet: hiding nothing is the
+// safe outcome.
+template <typename GetCss>
+nsresult ResolveWithStyle(RefPtr<ContentClassifierEngine> aEngine,
+                          dom::Promise* aPromise, GetCss&& aGetCss) {
+  nsIThread* backgroundThread = nsUrlClassifierDBService::BackgroundThread();
+  if (!backgroundThread) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  nsMainThreadPtrHandle<dom::Promise> promiseHolder(
+      new nsMainThreadPtrHolder<dom::Promise>("Blackout style promise",
+                                              aPromise));
+  return backgroundThread->Dispatch(
+      NS_NewRunnableFunction(
+          "Blackout style",
+          [engine = std::move(aEngine), getCss = std::forward<GetCss>(aGetCss),
+           promiseHolder]() {
+            nsCString css;
+            if (NS_FAILED(getCss(engine, css))) {
+              css.Truncate();
+            }
+            NS_DispatchToMainThread(NS_NewRunnableFunction(
+                "Blackout style resolve",
+                [promiseHolder, css = std::move(css)]() {
+                  promiseHolder->MaybeResolve(NS_ConvertUTF8toUTF16(css));
+                }));
+          }),
+      NS_DISPATCH_NORMAL);
+}
