+fn path_from(bytes: &nsACString) -> PathBuf {
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        PathBuf::from(std::ffi::OsStr::from_bytes(bytes.as_ref()))
+    }
+    #[cfg(not(unix))]
+    {
+        PathBuf::from(String::from_utf8_lossy(bytes.as_ref()).into_owned())
+    }
+}
+
+/// Vanta Blackout: builds an engine from the filter list files in
+/// `lists_dir`, reusing the compiled engine cached at `cache_path` when the
+/// lists have not changed. Fails with NS_ERROR_NOT_AVAILABLE when there are no
+/// lists yet.
+#[no_mangle]
+pub unsafe extern "C" fn content_classifier_engine_from_list_dir(
+    lists_dir: &nsACString,
+    cache_path: &nsACString,
+    out_engine: *mut *mut ContentClassifierFFIEngine,
+) -> nsresult {
+    if out_engine.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+
+    let lists_dir = path_from(lists_dir);
+    let cache_path = path_from(cache_path);
+    let engine = match blackout::engine_from_list_dir(&lists_dir, &cache_path) {
+        Some(engine) => engine,
+        None => return NS_ERROR_NOT_AVAILABLE,
+    };
+
+    *out_engine = Box::into_raw(Box::new(ContentClassifierFFIEngine::new(engine)));
+    NS_OK
+}
+
+/// Vanta Blackout: writes the element-hiding style sheet for a page at `url`
+/// to `out_css` (empty when nothing on the page is hidden). Generic selectors
+/// are included only when `include_generic` is set.
+#[no_mangle]
+pub unsafe extern "C" fn content_classifier_engine_cosmetic_css(
+    engine: *const ContentClassifierFFIEngine,
+    url: &nsACString,
+    include_generic: bool,
+    out_css: *mut nsCString,
+) -> nsresult {
+    if engine.is_null() || out_css.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+
+    let ffi_engine = &*engine;
+    let url_str = String::from_utf8_lossy(url.as_ref());
+    let generic = if include_generic {
+        None
+    } else {
+        Some(
+            ffi_engine
+                .generic_selectors
+                .get_or_init(|| blackout::generic_selectors(&ffi_engine.engine)),
+        )
+    };
+
+    let css = blackout::cosmetic_css(&ffi_engine.engine, &url_str, generic);
+    (*out_css).assign(&css);
+    NS_OK
+}
