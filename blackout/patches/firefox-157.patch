+NS_IMETHODIMP ContentClassifierService::GetCosmeticStyle(
+    const nsACString& aFeatureName, const nsACString& aUrl,
+    bool aIncludeGeneric, JSContext* aCx, dom::Promise** aPromise) {
+  NS_ENSURE_ARG_POINTER(aPromise);
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+
+  RefPtr<dom::Promise> promise;
+  nsresult rv = MakeProbePromise(aCx, getter_AddRefs(promise));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  RefPtr<ContentClassifierEngine> engine;
+  {
+    MutexAutoLock lock(mLock);
+    if (auto entry = mEngines.Lookup(nsCString(aFeatureName))) {
+      engine = entry.Data();
+    }
+  }
+  if (!engine) {
+    promise->MaybeResolve(nsString());
+    promise.forget(aPromise);
+    return NS_OK;
+  }
+
+  rv = ResolveWithStyle(std::move(engine), promise,
+                        [url = nsCString(aUrl), aIncludeGeneric](
+                            ContentClassifierEngine* aEngine, nsCString& aCss) {
+                          return aEngine->GetCosmeticCss(url, aIncludeGeneric,
+                                                         aCss);
+                        });
+  if (NS_FAILED(rv)) {
+    promise->MaybeReject(rv);
+  }
+  promise.forget(aPromise);
+  return NS_OK;
+}
