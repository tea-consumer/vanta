# Vanta Blackout: keeps the filter lists fresh, hides page elements, runs
# scriptlets, and adds its toolbar button and about:blackout.
# Network blocking itself happens in toolkit/components/content-classifier.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

MOZ_SRC_FILES += [
    "Blackout.sys.mjs",
    "BlackoutUI.sys.mjs",
]

JAR_MANIFESTS += ["jar.mn"]

FINAL_TARGET_FILES.actors += [
    "BlackoutChild.sys.mjs",
    "BlackoutParent.sys.mjs",
    "BlackoutScriptlets.js",
]
