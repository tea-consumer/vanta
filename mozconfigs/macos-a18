# Vanta: macOS on Apple A18 Pro (MacBook Neo)
# Used by scripts/build-macos.sh, which sets VANTA_PGO_STAGE for each of the
# three PGO stages. See docs/performance.md for why each flag is here.
ac_add_options --enable-application=browser
ac_add_options --target=aarch64-apple-darwin
ac_add_options --with-branding=browser/branding/vanta
ac_add_options --with-app-name=vanta

# Optimized release build. -O3 is already Firefox's default on macOS, so no
# --enable-optimize value is given here.
ac_add_options --enable-release
ac_add_options --enable-rust-simd

ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-tests
ac_add_options --disable-debug
ac_add_options --enable-strip
# PHC samples allocations to catch memory bugs for crash reports. With no
# crash reporter it only costs RAM and CPU (it is on for machines with 8 GB+).
ac_add_options --disable-phc

# Tune for the A18 Pro cores. If the bundled clang rejects apple-a18,
# use apple-m4 (same core generation). Mozilla's own builds use apple-m1.
export CFLAGS="-mcpu=apple-a18"
export CXXFLAGS="-mcpu=apple-a18"
export RUSTFLAGS="-C target-cpu=apple-a18"

# Linker: lld by default. Mozilla ships its macOS PGO+LTO builds with ld64
# because lld measured slower there; VANTA_LINKER=ld64 does the same with
# Xcode's linker, once a normal build is known to work.
if [ "${VANTA_LINKER:-lld}" = ld64 ]; then
  ac_add_options --enable-linker=ld64
  export MOZ_LD64_KNOWN_GOOD=1
else
  ac_add_options --enable-linker=lld
fi

# Profile-guided optimization, the same way Mozilla builds release Firefox:
# instrumented build -> training run -> final build, with "cross" so the Rust
# half of Gecko (Stylo, WebRender, ...) is profiled too. Plain MOZ_PGO=1
# only profiles C++.
case "${VANTA_PGO_STAGE:-}" in
  generate)
    ac_add_options --enable-profile-generate=cross
    mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vanta-instrumented
    ;;
  use)
    ac_add_options --enable-profile-use=cross
    ac_add_options --with-pgo-profile-path="$VANTA_PGO_DIR/merged.profdata"
    ac_add_options --with-pgo-jarlog="$VANTA_PGO_DIR/en-US.log"
    ac_add_options --enable-lto=cross
    mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vanta
    ;;
  *)
    # No PGO (VANTA_PGO=0): quicker build for testing, still LTO.
    ac_add_options --enable-lto=cross
    mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vanta
    ;;
esac
