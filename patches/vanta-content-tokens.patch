--- a/toolkit/themes/shared/design-system/dist/tokens-brand.css
+++ b/toolkit/themes/shared/design-system/dist/tokens-brand.css
@@ -98,3 +98,45 @@
     }
   }
 }
+
+
+/* Vanta: Settings, the new tab page, private windows and the other built-in
+ * pages take Vanta's palette instead of Firefox's: black canvas, raised
+ * near-black boxes, and Vanta's accent (mono unless vanta.accent picks
+ * another) where Firefox uses blue or violet. This layer comes after all of
+ * Firefox's token layers, so it wins over them, and pages' own styles still
+ * win over it. */
+@layer tokens-vanta {
+  :root,
+  :host(.anonymous-content-host) {
+    --color-accent-primary: light-dark(#1d1d24, #e6e6ec);
+    --color-accent-primary-hover: light-dark(#000000, #ffffff);
+    --color-accent-primary-active: light-dark(#000000, #ffffff);
+    --color-accent-primary-selected: light-dark(#1d1d24, #e6e6ec);
+    --button-text-color-primary: light-dark(#ffffff, #0a0a0a);
+    --text-color-accent-primary-selected: light-dark(#ffffff, #0a0a0a);
+    --button-background-color-primary-disabled: light-dark(#c4c4cc, #3a3a42);
+    --background-color-canvas: light-dark(#f4f4f6, #000000);
+    --background-color-box: light-dark(#ffffff, #0f0f12);
+    --background-color-information: light-dark(#ececf0, #16161a);
+
+    @media -moz-pref("vanta.accent", "ice") {
+      --color-accent-primary: light-dark(#2457b3, #9ec4ff);
+      --color-accent-primary-hover: light-dark(#1b4691, #b8d4ff);
+      --color-accent-primary-active: light-dark(#1b4691, #b8d4ff);
+      --color-accent-primary-selected: light-dark(#2457b3, #9ec4ff);
+    }
+    @media -moz-pref("vanta.accent", "sage") {
+      --color-accent-primary: light-dark(#4a6640, #a8c69a);
+      --color-accent-primary-hover: light-dark(#3b5233, #bdd6b1);
+      --color-accent-primary-active: light-dark(#3b5233, #bdd6b1);
+      --color-accent-primary-selected: light-dark(#4a6640, #a8c69a);
+    }
+    @media -moz-pref("vanta.accent", "ember") {
+      --color-accent-primary: light-dark(#a2501b, #f4b183);
+      --color-accent-primary-hover: light-dark(#843f13, #f8c6a3);
+      --color-accent-primary-active: light-dark(#843f13, #f8c6a3);
+      --color-accent-primary-selected: light-dark(#a2501b, #f4b183);
+    }
+  }
+}
