+#ifndef mozilla_nsCookieBannerService_h_
+#define mozilla_nsCookieBannerService_h_
+
+#include "nsICookieBannerRule.h"
+#include "nsICookieBannerService.h"
+#include "nsICookieBannerListService.h"
+#include "nsCOMPtr.h"
