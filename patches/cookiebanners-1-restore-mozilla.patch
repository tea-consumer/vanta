+
+  info(
+    "Testing that methods throw NS_ERROR_NOT_AVAILABLE if the service is disabled."
+  );
+
+  Assert.throws(
+    () => {
+      Services.cookieBanners.rules;
+    },
+    /NS_ERROR_NOT_AVAILABLE/,
