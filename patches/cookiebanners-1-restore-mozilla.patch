+NS_IMETHODIMP
+nsCookieBannerService::GetIsEnabled(bool* aResult) {
+  NS_ENSURE_ARG_POINTER(aResult);
+
+  *aResult = mIsInitialized;
+
+  return NS_OK;
+}
