--- a/browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css
+++ b/browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css
@@ -735,3 +735,33 @@
     }
   }
 }
+
+/* Vanta: a private window is Vanta's black with its own total-eclipse mark,
+   not Firefox's violet page, fox tail and mask. */
+@media not (prefers-contrast) {
+  html.private {
+    --background-color-canvas: #000000 !important;
+    --link-color: var(--color-accent-primary) !important;
+    --link-color-hover: var(--color-accent-primary-hover) !important;
+    --link-color-active: var(--color-accent-primary-active) !important;
+    background: #000000 !important;
+  }
+
+  html.private body::before {
+    display: none !important;
+  }
+
+  content-search-handoff-ui {
+    --content-search-handoff-ui-background-color: #0f0f12 !important;
+    --content-search-handoff-ui-unfocused-border-color: rgba(255, 255, 255, 0.08) !important;
+    --content-search-handoff-ui-fakefocus-border-color: var(--color-accent-primary) !important;
+    --content-search-handoff-ui-fakefocus-box-shadow-inner: var(--color-accent-primary) !important;
+    --content-search-handoff-ui-fakefocus-box-shadow-outer: color-mix(in srgb, var(--color-accent-primary) 25%, transparent) !important;
+    background: none !important;
+    box-shadow: none !important;
+  }
+}
+
+.logo {
+  background: image-set(url("chrome://branding/content/about-logo-private.png"), url("chrome://branding/content/about-logo-private@2x.png") 2x) no-repeat center / contain !important;
+}
