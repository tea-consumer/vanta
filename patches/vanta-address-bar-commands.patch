+// Vanta: Blackout is the content blocker (privacy.trackingprotection.content.
+// protection.enabled); a site where it is off is on the content blocking
+// allow list, the same per-site switch as the shield and the Blackout panel.
+let blackoutOn = () =>
+  Services.prefs.getBoolPref(
+    "privacy.trackingprotection.content.protection.enabled",
+    false
+  );
+let blackoutApplies = () =>
+  ["http", "https"].includes(currentBrowser().currentURI.scheme);
+let blackoutOffHere = () =>
+  lazy.ContentBlockingAllowList.includes(currentBrowser());
+let toggleBlackoutHere = (_queryContext, controller) => {
+  let window = controller.browserWindow;
+  if (blackoutOffHere()) {
+    window.gProtectionsHandler.enableForCurrentPage(false);
+  } else {
+    window.gProtectionsHandler.disableForCurrentPage(false);
+  }
+  window.gBrowser.reloadTab(window.gBrowser.selectedTab);
+  return { focusContent: true };
+};
+let backgroundTabs = window =>
+  window.gBrowser.tabs.filter(
+    tab =>
+      !tab.selected &&
+      !tab.splitview?.hasActiveTab &&
+      !tab.hasAttribute("pending") &&
+      !tab.soundPlaying
+  );
+
