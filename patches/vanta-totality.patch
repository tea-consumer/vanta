index 757c5b1..5152072 100644
--- a/browser/base/content/browser-commands.js
+++ b/browser/base/content/browser-commands.js
@@ -104,6 +104,16 @@ var BrowserCommands = {
     gBrowser.selectedTab?.splitview?.unsplitTabs("keyboard_shortcut");
   },
 
+  // Vanta: Totality mode. The toolbar and tab rail fade into the dark frame
+  // so only the page is lit (chrome/vanta.css styles [vanta-totality]). The
+  // same shortcut, or the "totality" address bar command, brings them back.
+  toggleVantaTotality() {
+    if (document.documentElement.toggleAttribute("vanta-totality")) {
+      // The toolbar stays visible while it has focus, so hand it to the page.
+      gBrowser.selectedBrowser.focus();
+    }
+  },
+
   duplicateTab() {
     duplicateTabIn(gBrowser.selectedTab, "tab");
   },
