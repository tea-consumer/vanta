   return profiler_feature_active(ProfilerFeature::Screenshots);
 }
 
+// Vanta: milliseconds since process start of the last APZ scroll activity,
+// plus one so that 0 means "never".
+static Atomic<uint64_t, Relaxed> sLastScrollActivityMs(0);
+
+static uint64_t NowMs() {
+  return uint64_t(
+             (TimeStamp::Now() - TimeStamp::ProcessCreation()).ToMilliseconds()) +
+         1;
+}
+
+/* static */
+void ProfilerScreenshots::NotifyScrollActivity() {
+  if (StaticPrefs::gfx_vanta_frame_readback() == 1) {
+    sLastScrollActivityMs = NowMs();
+  }
+}
+
+/* static */
+bool ProfilerScreenshots::ReadbackActive() {
+  return IsEnabled() || StaticPrefs::gfx_vanta_frame_readback() != 0;
+}
+
+/* static */
+bool ProfilerScreenshots::ShouldCapture() {
+  if (IsEnabled()) {
+    return true;
+  }
+  switch (StaticPrefs::gfx_vanta_frame_readback()) {
+    case 0:
+      return false;
+    case 1: {
+      // Keep going for a second after the last scroll step, so momentum
+      // scrolling and the frames right after it stay covered.
+      uint64_t last = sLastScrollActivityMs;
+      return last && NowMs() - last < 1000;
+    }
+    default:
+      return true;
+  }
+}
+
