diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
index 964f67c0..c6960ab3 100644
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -8497,6 +8497,21 @@
 #endif
   mirror: always
 
+# Vanta: run the profiler's per-frame screenshot readback even when the
+# profiler is off. On Apple Silicon this small amount of GPU work per frame
+# keeps the GPU from idling between frames, which otherwise makes trackpad
+# scrolling stutter on screen even though frames are produced on time.
+# 0 = off, 1 = only while APZ is scrolling (and 1 s after), 2 = every frame.
+# On by default on macOS only, where the stutter was seen.
+- name: gfx.vanta.frame-readback
+  type: RelaxedAtomicUint32
+#ifdef XP_MACOSX
+  value: 1
+#else
+  value: 0
+#endif
+  mirror: always
+
 - name: gfx.webrender.compositor
   type: bool
 #if defined(XP_WIN) || defined(XP_DARWIN) || defined(MOZ_WIDGET_GTK)
