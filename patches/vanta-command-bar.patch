+// Vanta: the command bar layout (vanta.layout.commandBar). There is no
+// toolbar row; the address bar floats over the page when summoned (styles in
+// vanta.css). A new tab is a blank page with the command bar and the most
+// visited sites drawn by the window itself, so it costs no extra process.
+var VantaShape = {
+  PREF: "vanta.layout.commandBar",
+  PLACEHOLDER: "Search or go to a site",
+  SITES: 8,
+
+  init() {
+    if (!Services.prefs.getBoolPref(this.PREF, true)) {
+      return;
+    }
+    document.documentElement.setAttribute("vanta-command-bar", "true");
+    AboutNewTab.newTabURL = "about:blank";
+
+    // Firefox's placeholder names the search engine; Vanta's doesn't. Fluent
+    // sets it again whenever the engine changes, so keep putting ours back.
+    let input = gURLBar.inputField;
+    let placeholder = () => {
+      if (input.placeholder != this.PLACEHOLDER) {
+        input.placeholder = this.PLACEHOLDER;
+      }
+    };
+    new MutationObserver(placeholder).observe(input, {
+      attributes: true,
+      attributeFilter: ["placeholder"],
+    });
+    placeholder();
+
+    // The rail keeps only tabs: no bookmarks, history or settings buttons.
+    let sidebar = document.querySelector("sidebar-main");
+    customElements.whenDefined("sidebar-main").then(() => {
+      let style = document.createElementNS(
+        "http://www.w3.org/1999/xhtml",
+        "style"
+      );
+      style.textContent = ".buttons-wrapper { visibility: hidden; }";
+      sidebar?.shadowRoot?.append(style);
+    });
+
+    this.sites = document.createElementNS(
+      "http://www.w3.org/1999/xhtml",
+      "div"
+    );
+    this.sites.id = "vanta-void-sites";
+    this.sites.addEventListener("click", this);
+    document.getElementById("tabbrowser-tabbox").append(this.sites);
+
+    gBrowser.addTabsProgressListener(this);
+    gBrowser.tabContainer.addEventListener("TabSelect", this);
+    this.update();
+  },
+
+  // A blank tab the user opened, not a page a site opened and writes into.
+  isVoid(browser) {
+    return (
+      browser.currentURI.spec == "about:blank" &&
+      !browser.isLoadingDocument &&
+      !browser.browsingContext?.opener &&
+      !browser.hasContentOpener
+    );
+  },
+
+  onLocationChange(browser, webProgress) {
+    if (webProgress.isTopLevel && browser == gBrowser.selectedBrowser) {
+      this.update();
+    }
+  },
+
+  handleEvent(event) {
+    if (event.type == "TabSelect") {
+      this.update();
+      return;
+    }
+    let link = event.target.closest("a");
+    if (link) {
+      event.preventDefault();
+      openTrustedLinkIn(link.href, whereToOpenLink(event, false, false));
+    }
+  },
+
+  update() {
+    let empty = this.isVoid(gBrowser.selectedBrowser);
+    document.documentElement.toggleAttribute("vanta-void", empty);
+    if (empty) {
+      this.fill();
+    }
+  },
+
+  // "nrk.no" -> "nrk", "en.wikipedia.org" -> "wikipedia".
+  siteName(link) {
+    try {
+      let host = new URL(link.url).hostname;
+      let base = Services.eTLD.getBaseDomainFromHost(host);
+      let suffix = Services.eTLD.getPublicSuffixFromHost(host);
+      return base.slice(0, -suffix.length - 1);
+    } catch (e) {
+      return link.title || link.url;
+    }
+  },
+
+  async fill() {
+    let links = [];
+    try {
+      links = await NewTabUtils.activityStreamLinks.getTopSites({
+        numItems: this.SITES,
+        onePerDomain: true,
+      });
+    } catch (e) {
+      console.error(e);
+    }
+    let html = "http://www.w3.org/1999/xhtml";
+    let items = links.slice(0, this.SITES).map(link => {
+      let a = document.createElementNS(html, "a");
+      a.href = link.url;
+      let orb = document.createElementNS(html, "span");
+      orb.className = "vanta-void-orb";
+      let icon = document.createElementNS(html, "img");
+      icon.src = "page-icon:" + link.url;
+      orb.append(icon);
+      let name = document.createElementNS(html, "span");
+      name.textContent = this.siteName(link);
+      a.append(orb, name);
+      return a;
+    });
+    this.sites.replaceChildren(...items);
+  },
+};
+delayedStartupPromise.then(() => VantaShape.init());
