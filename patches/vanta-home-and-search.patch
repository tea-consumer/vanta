+    let pages = [];
+    for (let row of rows) {
+      let url = row.getResultByName("url");
+      let host;
+      try {
+        host = new URL(url).hostname.replace(/^www\./, "");
+      } catch (e) {
+        continue;
+      }
+      // One page per site keeps the list short and varied.
+      if (!hosts.has(host) && /^https?:/.test(url)) {
+        hosts.add(host);
+        pages.push({ url, host, title: row.getResultByName("title") });
+      }
+    }
+    return pages;
+  },
+
+  el(tag, props = {}, ...children) {
+    let node = document.createElementNS(this.HTML, tag);
+    for (let [key, value] of Object.entries(props)) {
+      if (key == "class") {
+        node.className = value;
+      } else {
+        node.setAttribute(key, value);
+      }
+    }
+    node.append(...children);
+    return node;
+  },
+};
+delayedStartupPromise.then(() => VantaHome.init());
