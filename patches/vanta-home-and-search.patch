+// Vanta: the address bar answers and acts, not only searches.
+//  - Answers computed locally as you type: maths and units (Firefox's own
+//    calculator and converter, switched on in prefs), and the time in any
+//    city ("time tokyo", "tokyo time").
+//  - A site's name and a space searches that site: "yr oslo", "nrk valg".
+//    Sites come from your history; Enter goes straight there.
+//  - Shift+Enter opens the chosen result in split view beside this page.
+// The provider is shared by all windows, so the first window registers it
+// and hands it to another window when it closes.
+var VantaSearch = {
+  PREF: "vanta.search.answers",
+
+  init() {
+    if (!Services.prefs.getBoolPref(this.PREF, true)) {
+      return;
+    }
+    this.register();
+    // Window capture, so this runs before the address bar's own Enter.
+    window.addEventListener("keydown", this, true);
+    this.keepPlaceholder();
+    this.siteChip();
+  },
+
+  // Typing a site's name and a space puts that site in the field: its icon
+  // and name, lit, so you see where the words will be searched.
+  siteChip() {
+    let input = gURLBar.inputField;
+    let chip = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+    chip.id = "vanta-site-chip";
+    let icon = document.createElementNS("http://www.w3.org/1999/xhtml", "img");
+    let name = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+    chip.append(icon, name);
+    input.parentNode.before(chip);
+    let show = () => {
+      let m = /^(\S+)\s+\S/.exec(input.value);
+      let host =
+        m &&
+        !gURLBar.searchMode &&
+        !PrivateBrowsingUtils.isWindowPrivate(window) &&
+        this.manager.getProvider("VantaSiteSearch")?.siteFor(m[1]);
+      if (host) {
+        icon.src = `page-icon:https://${host}/`;
+        name.textContent = host;
+      }
+      gURLBar.toggleAttribute("vanta-site", !!host);
+    };
+    input.addEventListener("input", show);
+    input.addEventListener("blur", () => gURLBar.removeAttribute("vanta-site"));
+  },
+
+  // Firefox's placeholder names the search engine; Vanta's says what the
+  // field does. Fluent sets it again when the engine changes, so keep ours.
+  keepPlaceholder() {
+    let input = gURLBar.inputField;
+    let text = "Search, calculate, or go to a site";
+    let put = () => {
+      if (input.placeholder != text) {
+        input.placeholder = text;
+      }
+    };
+    new MutationObserver(put).observe(input, {
+      attributes: true,
+      attributeFilter: ["placeholder"],
+    });
+    put();
+  },
+
+  get manager() {
+    let { ProvidersManager } = ChromeUtils.importESModule(
+      "moz-src:///browser/components/urlbar/UrlbarProvidersManager.sys.mjs"
+    );
+    return ProvidersManager.getInstanceForSap("urlbar");
+  },
+
+  register() {
+    let manager = this.manager;
+    if (manager.getProvider("VantaSiteSearch")) {
+      return;
+    }
+    let providers = this.makeProviders();
+    for (let provider of providers) {
+      manager.registerProvider(provider);
+    }
+    // Heuristic results are ranked by provider order. Site search only runs
+    // for "<a site you visit> <words>", and then it should win over the
+    // plain web search, so it goes first.
+    let list = manager.providers;
+    list.unshift(...list.splice(list.indexOf(providers[0]), 1));
+    window.addEventListener(
+      "unload",
+      () => {
+        for (let provider of providers) {
+          manager.unregisterProvider(provider);
+        }
+        let next = BrowserWindowTracker.orderedWindows.find(
+          w => w != window && w.VantaSearch
+        );
+        next?.VantaSearch.register();
+      },
+      { once: true }
+    );
+  },
+
+  // Shift+Enter: open the selected result beside this page.
+  handleEvent(event) {
+    if (
+      event.target != gURLBar.inputField ||
+      event.key != "Enter" ||
+      !event.shiftKey ||
+      event.altKey
+    ) {
+      return;
+    }
+    let tab = gBrowser.selectedTab;
+    if (tab.pinned || tab.splitview || !gURLBar.view.isOpen) {
+      return;
+    }
+    let result = gURLBar.view.selectedResult;
+    let url = result?.payload.url;
+    if (!url && result?.payload.engine) {
+      let { SearchService } = ChromeUtils.importESModule(
+        "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+      );
+      let engine = SearchService.getEngineByName(result.payload.engine);
+      url = engine?.getSubmission(result.payload.query || gURLBar.value).uri
+        .spec;
+    }
+    if (!url) {
+      return;
+    }
+    event.preventDefault();
+    event.stopPropagation();
+    gURLBar.view.close();
+    gURLBar.handleRevert();
+    let newTab = gBrowser.addTrustedTab(url, { index: tab._tPos + 1 });
+    gBrowser.addTabSplitView([tab, newTab], { trigger: "vanta_urlbar" });
+    gBrowser.selectedTab = newTab;
+  },
+
+  makeProviders() {
+    const { UrlbarProvider } = ChromeUtils.importESModule(
+      "moz-src:///browser/components/urlbar/UrlbarUtils.sys.mjs"
+    );
+    const { UrlbarResult } = ChromeUtils.importESModule(
+      "chrome://browser/content/urlbar/UrlbarResult.mjs"
+    );
+    const { UrlbarShared } = ChromeUtils.importESModule(
+      "chrome://browser/content/urlbar/UrlbarShared.mjs"
+    );
+    const { SearchService } = ChromeUtils.importESModule(
+      "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+    );
+
+    // Every IANA zone's city, so "time são paulo" or "time reykjavik" work
+    // without a list of our own.
+    let zones = new Map();
+    for (let zone of Intl.supportedValuesOf("timeZone")) {
+      let city = zone.split("/").pop().replace(/_/g, " ").toLowerCase();
+      zones.set(city, zone);
+    }
+    for (let [city, zone] of [
+      ["new york", "America/New_York"],
+      ["san francisco", "America/Los_Angeles"],
+      ["beijing", "Asia/Shanghai"],
+      ["delhi", "Asia/Kolkata"],
+      ["mumbai", "Asia/Kolkata"],
+      ["bergen", "Europe/Oslo"],
+      ["trondheim", "Europe/Oslo"],
+      ["washington", "America/New_York"],
+      ["seattle", "America/Los_Angeles"],
+      ["boston", "America/New_York"],
+    ]) {
+      zones.set(city, zone);
+    }
+
+    let timeAnswer = text => {
+      let m = /^(?:time\s+(?:in\s+)?(.+)|(.+?)\s+time)$/i.exec(text.trim());
+      let city = (m?.[1] || m?.[2])?.toLowerCase();
+      let zone = city && zones.get(city);
+      if (!zone) {
+        return null;
+      }
+      let now = new Date();
+      let time = now.toLocaleTimeString(undefined, {
+        timeZone: zone,
+        hour: "2-digit",
+        minute: "2-digit",
+      });
+      let day = now.toLocaleDateString(undefined, {
+        timeZone: zone,
+        weekday: "long",
+        day: "numeric",
+        month: "long",
+      });
+      let offset = tz => {
+        let parts = new Intl.DateTimeFormat("en-US", {
+          timeZone: tz,
+          timeZoneName: "longOffset",
+        }).formatToParts(now);
+        let name = parts.find(p => p.type == "timeZoneName").value;
+        let [, sign, h, mm] = /GMT(?:([+-])(\d+):?(\d+)?)?/.exec(name) || [];
+        return sign ? (sign == "-" ? -1 : 1) * (+h * 60 + +(mm || 0)) : 0;
+      };
+      let diff =
+        (offset(zone) -
+          offset(Intl.DateTimeFormat().resolvedOptions().timeZone)) /
+        60;
+      let place = city.replace(/\b\w/g, c => c.toUpperCase());
+      let rel =
+        diff == 0
+          ? "same time as you"
+          : `${Math.abs(diff)} h ${diff > 0 ? "ahead of" : "behind"} you`;
+      // Where the sun is there: 0deg at 6:00 (rising), 180deg at 18:00.
+      let [h, mm] = new Intl.DateTimeFormat("en-GB", {
+        timeZone: zone,
+        hour: "2-digit",
+        minute: "2-digit",
+        hourCycle: "h23",
+      })
+        .format(now)
+        .split(":")
+        .map(Number);
+      let angle = ((((h + mm / 60 - 6) / 24) * 360) % 360 + 360) % 360;
+      return { title: time, detail: `${place} · ${day} · ${rel}`, angle };
+    };
+
+    // Sites you visit, by name: "nrk" -> nrk.no.
+    let sites = null;
+    let loadSites = async () => {
+      let rows = await PlacesUtils.withConnectionWrapper(
+        "VantaSearch",
+        db =>
+          db.executeCached(
+            `SELECT host, frecency FROM moz_origins
+             WHERE frecency <> 0 ORDER BY frecency DESC LIMIT 400`
+          )
+      );
+      sites = new Map();
+      for (let row of rows) {
+        let host = row.getResultByName("host");
+        let name;
+        try {
+          let base = Services.eTLD.getBaseDomainFromHost(host);
+          let suffix = Services.eTLD.getPublicSuffixFromHost(host);
+          name = base.slice(0, -suffix.length - 1);
+        } catch (e) {
+          continue;
+        }
+        if (name && !sites.has(name)) {
+          sites.set(name, host.replace(/^www\./, ""));
+        }
+      }
+      setTimeout(() => (sites = null), 10 * 60 * 1000);
+    };
+    let siteSearch = async text => {
+      let m = /^(\S+)\s+(.+)$/.exec(text.trim());
+      if (!m) {
+        return null;
+      }
+      if (!sites) {
+        await loadSites();
+      }
+      let host = sites.get(m[1].toLowerCase());
+      if (!host) {
+        return null;
+      }
+      // The site's own engine when one is installed (Wikipedia, YouTube…),
+      // otherwise your default engine limited to that site.
+      let engine = (await SearchService.getVisibleEngines()).find(e => {
+        try {
+          return e.searchUrlDomain.endsWith(host.split(".").slice(-2).join("."));
+        } catch (ex) {
+          return false;
+        }
+      });
+      let query = m[2];
+      let url = engine
+        ? engine.getSubmission(query).uri.spec
+        : (await SearchService.getDefault()).getSubmission(
+            `site:${host} ${query}`
+          ).uri.spec;
+      return { url, host, query };
+    };
+
+    class VantaAnswers extends UrlbarProvider {
+      get name() {
+        return "VantaAnswers";
+      }
+      get type() {
+        return UrlbarShared.PROVIDER_TYPE.PROFILE;
+      }
+      async isActive(context) {
+        this.answer = timeAnswer(context.searchString);
+        return !!this.answer && !context.restrictInSearchMode?.();
+      }
+      startQuery(context, add) {
+        add(
+          this,
+          new UrlbarResult({
+            type: UrlbarShared.RESULT_TYPE.DYNAMIC,
+            source: UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+            suggestedIndex: 1,
+            payload: { dynamicType: "vantaAnswer", ...this.answer },
+          })
+        );
+      }
+      getViewTemplate() {
+        return {
+          attributes: { selectable: true },
+          children: [
+            {
+              name: "content",
+              tag: "span",
+              classList: ["urlbarView-no-wrap", "vanta-answer"],
+              children: [
+                {
+                  name: "sky",
+                  tag: "span",
+                  classList: ["vanta-answer-sky"],
+                  children: [{ name: "body", tag: "span", classList: ["vanta-answer-body"] }],
+                },
+                { name: "title", tag: "strong", classList: ["vanta-answer-title"] },
+                { name: "detail", tag: "span", classList: ["vanta-answer-detail"] },
+              ],
+            },
+          ],
+        };
+      }
+      getViewUpdate(result) {
+        return {
+          title: { textContent: result.payload.title },
+          detail: { textContent: result.payload.detail },
+          sky: {
+            // At night the moon takes the same arc.
+            style: { "--angle": `${result.payload.angle % 180}deg` },
+            attributes: { night: result.payload.angle > 180 },
+          },
+        };
+      }
+    }
+
+    // Heuristic, so Enter goes to the site's results. Only active when the
+    // first word is the name of a site you visit and more words follow.
+    class VantaSiteSearch extends UrlbarProvider {
+      // For the field's site chip, which can't wait for history.
+      siteFor(name) {
+        if (!sites) {
+          loadSites();
+          return null;
+        }
+        return sites.get(name.toLowerCase());
+      }
+      get name() {
+        return "VantaSiteSearch";
+      }
+      get type() {
+        return UrlbarShared.PROVIDER_TYPE.HEURISTIC;
+      }
+      async isActive(context) {
+        if (
+          context.searchMode ||
+          context.restrictSource ||
+          context.isPrivate ||
+          /^[a-z]+:|\//i.test(context.searchString)
+        ) {
+          return false;
+        }
+        this.found = await siteSearch(context.searchString);
+        return !!this.found;
+      }
+      getPriority() {
+        return 0;
+      }
+      startQuery(context, add) {
+        let { url, host, query } = this.found;
+        add(
+          this,
+          new UrlbarResult({
+            type: UrlbarShared.RESULT_TYPE.URL,
+            source: UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+            heuristic: true,
+            payload: {
+              url,
+              title: `Search ${host} for “${query}”`,
+              icon: `page-icon:https://${host}/`,
+            },
+          })
+        );
+      }
+    }
+
+    return [new VantaSiteSearch(), new VantaAnswers()];
+  },
+};
+delayedStartupPromise.then(() => VantaSearch.init());
+
+// Vanta: search results drawn by Vanta. Searches go to DuckDuckGo's
+// script-free results page (private, no trackers, no scripts) and Vanta
+// styles all of it: RESULTS is the whole look of that page. DuckDuckGo's
+// regular pages (images, news) get a lighter skin, DDG, whose rules only
+// match that page's markup. The engine is added
+// and made the default once, so a later choice in Settings sticks;
+// vanta.search.skin turns both styles off.
+var VantaSearchSkin = {
+  ENGINE: "Vanta",
+  ENGINE_PREF: "vanta.search.engineSet",
+  SKIN_PREF: "vanta.search.skin",
+
+  init() {
+    this.setEngine();
+    this.showSearchTerms();
+    if (Services.prefs.getBoolPref(this.SKIN_PREF, true)) {
+      this.register("html.duckduckgo.com", this.RESULTS);
+      this.register("duckduckgo.com", this.DDG);
+    }
+  },
+
+  // A user style sheet for one site, shared by every window.
+  register(domain, css) {
+    let sss = Cc["@mozilla.org/content/style-sheet-service;1"].getService(
+      Ci.nsIStyleSheetService
+    );
+    let uri = Services.io.newURI(
+      "data:text/css;charset=utf-8," +
+        encodeURIComponent(`@-moz-document domain("${domain}") {\n${css}\n}`)
+    );
+    if (!sss.sheetRegistered(uri, sss.USER_SHEET)) {
+      sss.loadAndRegisterSheet(uri, sss.USER_SHEET);
+    }
+  },
+
+  // The address bar shows only the words you searched, as Firefox does for
+  // its built-in engines. Firefox only recognises those engines' pages, so
+  // the shared check also accepts Vanta's results page. The wrapper lives in
+  // its own sandbox so it outlives the window that installed it.
+  showSearchTerms() {
+    let { UrlbarSearchTermsPersistence: persistence } = ChromeUtils.importESModule(
+      "moz-src:///browser/components/urlbar/UrlbarSearchTermsPersistence.sys.mjs"
+    );
+    if (persistence.vantaWrapped) {
+      return;
+    }
+    let sandbox = Cu.Sandbox(Services.scriptSecurityManager.getSystemPrincipal(), {
+      wantGlobalProperties: ["URL"],
+    });
+    let wrap = Cu.evalInSandbox(
+      `(original => function (uri) {
+        let terms = original.call(this, uri);
+        if (terms) {
+          return terms;
+        }
+        try {
+          let url = URL.fromURI(uri);
+          let query = url.searchParams.get("q")?.trim();
+          if (
+            url.hostname == "html.duckduckgo.com" &&
+            url.pathname.startsWith("/html") &&
+            query &&
+            query.length <= 1000 &&
+            !/^https?:/.test(query)
+          ) {
+            return url.searchParams.get("q");
+          }
+        } catch (e) {}
+        return "";
+      })`,
+      sandbox,
+      null,
+      "chrome://browser/content/browser-init.js"
+    );
+    persistence.getSearchTerm = wrap(persistence.getSearchTerm);
+    persistence.vantaWrapped = true;
+  },
+
+  async setEngine() {
+    let { SearchService } = ChromeUtils.importESModule(
+      "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+    );
+    await SearchService.init();
+    let engine = SearchService.getEngineByName(this.ENGINE);
+    if (!engine) {
+      engine = await SearchService.addUserEngine({
+        name: this.ENGINE,
+        url: "https://html.duckduckgo.com/html/?q={searchTerms}",
+        suggestUrl: "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
+      });
+    }
+    if (Services.prefs.getBoolPref(this.ENGINE_PREF, false)) {
+      return;
+    }
+    await SearchService.setDefault(engine, SearchService.CHANGE_REASON.USER);
+    await SearchService.setDefaultPrivate(engine, SearchService.CHANGE_REASON.USER);
+    Services.prefs.setBoolPref(this.ENGINE_PREF, true);
+  },
+
+  RESULTS: `
+    /* Vanta's results page. DuckDuckGo's script-free HTML page supplies the
+       results; everything you see is drawn here: true black, your search set
+       large like the new tab's heading, results as type, and the new tab's
+       horizon low in the window. */
+
+    html, body {
+      background: #000 !important;
+      color: #fff !important;
+      margin: 0 !important;
+    }
+    body {
+      font: 400 16px/1.55 "SF Pro Text", -apple-system, "Inter", "Helvetica Neue", sans-serif !important;
+      -moz-osx-font-smoothing: grayscale;
+      padding: 0 0 22vh 12vw !important;
+      max-width: 760px !important;
+    }
+
+    /* The horizon from the new tab, low and dim, so the page reads as the same
+       place a little later in the evening. */
+    html::before {
+      content: "";
+      position: fixed;
+      left: 50%;
+      top: 94vh;
+      width: 420vw;
+      aspect-ratio: 1;
+      margin-left: -210vw;
+      border-radius: 50%;
+      background: #000;
+      box-shadow:
+        0 -1px 0 rgba(170, 185, 215, .4),
+        0 -8px 30px -6px rgba(170, 185, 215, .14),
+        0 -50px 140px -30px rgba(170, 185, 215, .08);
+      pointer-events: none;
+      z-index: 0;
+    }
+    body > * { position: relative; z-index: 1; }
+
+    /* Header: no logo, no box. The query is the page's heading. */
+    .header__logo-wrap, .header__logo, .search__button, .site-wrapper-border,
+    #state_hidden, .result__extras__url > span:not(.result__icon),
+    .header__form .frm__select, #bottom_spacing2,
+    .feedback-btn, .result--ad, .badge--ad, #zero_click_wrapper {
+      display: none !important;
+    }
+    .header, .header-wrap, .header__form, .search, .search--header {
+      all: unset !important;
+      display: block !important;
+    }
+    .header { padding-top: 11vh !important; }
+    .header::before {
+      content: "DuckDuckGo · private";
+      display: block;
+      margin: 0 0 18px 2px;
+      font: 600 12px/14px "SF Pro Text", -apple-system, system-ui, sans-serif;
+      letter-spacing: .18em;
+      text-transform: uppercase;
+      color: rgba(255, 255, 255, .45);
+    }
+    .search__input {
+      all: unset !important;
+      display: block !important;
+      width: 100% !important;
+      font: 650 56px/1.1 "SF Pro Display", "Inter Display", -apple-system, "Helvetica Neue", sans-serif !important;
+      letter-spacing: -.035em !important;
+      color: #fff !important;
+      caret-color: #fff !important;
+      text-rendering: geometricPrecision;
+    }
+
+    /* Results: the site in small spaced capitals, the title, then the words. */
+    .serp__results, .results, #links { all: unset !important; display: block !important; margin-top: 7vh !important; }
+    .result {
+      all: unset !important;
+      display: block !important;
+      margin: 0 0 42px !important;
+    }
+    .result__body {
+      display: flex !important;
+      flex-direction: column !important;
+      padding: 0 !important;
+      background: none !important;
+      border: 0 !important;
+    }
+    .result__extras { order: -1; margin: 0 0 8px !important; }
+    .result__extras__url { display: flex !important; align-items: center !important; gap: 10px !important; }
+    .result__icon, .result__icon a { display: inline-flex !important; }
+    .result__icon__img {
+      width: 14px !important;
+      height: 14px !important;
+      border-radius: 3px;
+      opacity: .85;
+      filter: grayscale(.6);
+    }
+    .result__url {
+      font: 600 11.5px/14px "SF Pro Text", -apple-system, system-ui, sans-serif !important;
+      letter-spacing: .16em !important;
+      text-transform: uppercase !important;
+      color: rgba(255, 255, 255, .4) !important;
+      text-decoration: none !important;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+      max-width: 100%;
+    }
+    .result__title { margin: 0 !important; font: inherit !important; }
+    .result__a {
+      font: 500 26px/1.22 "SF Pro Display", "Inter Display", -apple-system, "Helvetica Neue", sans-serif !important;
+      letter-spacing: -.02em !important;
+      color: #fff !important;
+      text-decoration: none !important;
+    }
+    .result__a:visited { color: rgba(255, 255, 255, .5) !important; }
+    .result__a:hover { text-decoration: underline 1px !important; text-underline-offset: 6px !important; }
+    .result__snippet {
+      display: block !important;
+      margin-top: 8px !important;
+      font-size: 16px !important;
+      line-height: 1.6 !important;
+      color: rgba(255, 255, 255, .55) !important;
+      text-decoration: none !important;
+    }
+    .result__snippet b { color: #fff !important; font-weight: 500 !important; }
+
+    /* Next page: a word, not a button. */
+    .nav-link form { display: inline !important; }
+    .nav-link input[type="submit"] {
+      all: unset !important;
+      cursor: pointer !important;
+      font: 600 12px/14px "SF Pro Text", -apple-system, system-ui, sans-serif !important;
+      letter-spacing: .18em !important;
+      text-transform: uppercase !important;
+      color: rgba(255, 255, 255, .6) !important;
+      margin-right: 28px !important;
+    }
+    .nav-link input[type="submit"]:hover { color: #fff !important; }
+
+    @media (prefers-reduced-motion: no-preference) {
