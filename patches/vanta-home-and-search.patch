+
+// Vanta: the address bar answers and acts, not only searches.
+//  - Answers computed locally as you type: maths and units (Firefox's own
+//    calculator and converter, switched on in prefs), and the time in any
+//    city ("time tokyo", "tokyo time").
+//  - A site's name and a space searches that site: "yr oslo", "nrk valg".
+//    Sites come from your history; Enter goes straight there.
+//  - Shift+Enter opens the chosen result in split view beside this page.
+// The provider is shared by all windows, so the first window registers it
+// and hands it to another window when it closes.
+var VantaSearch = {
+  PREF: "vanta.search.answers",
+
+  init() {
+    if (!Services.prefs.getBoolPref(this.PREF, true)) {
+      return;
+    }
+    this.register();
+    // Window capture, so this runs before the address bar's own Enter.
+    window.addEventListener("keydown", this, true);
+    this.keepPlaceholder();
+    this.siteChip();
+  },
+
+  // Typing a site's name and a space puts that site in the field: its icon
+  // and name, lit, so you see where the words will be searched.
+  siteChip() {
+    let input = gURLBar.inputField;
+    let chip = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+    chip.id = "vanta-site-chip";
+    let icon = document.createElementNS("http://www.w3.org/1999/xhtml", "img");
+    let name = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+    chip.append(icon, name);
+    input.parentNode.before(chip);
+    let show = () => {
+      let m = /^(\S+)\s+\S/.exec(input.value);
+      let host =
+        m &&
+        !gURLBar.searchMode &&
+        !PrivateBrowsingUtils.isWindowPrivate(window) &&
+        this.manager.getProvider("VantaSiteSearch")?.siteFor(m[1]);
+      if (host) {
+        icon.src = `page-icon:https://${host}/`;
+        name.textContent = host;
+      }
+      gURLBar.toggleAttribute("vanta-site", !!host);
+    };
+    input.addEventListener("input", show);
+    input.addEventListener("blur", () => gURLBar.removeAttribute("vanta-site"));
+  },
+
+  // Firefox's placeholder names the search engine; Vanta's says what the
+  // field does. Fluent sets it again when the engine changes, so keep ours.
+  keepPlaceholder() {
+    let input = gURLBar.inputField;
+    let text = "Search, calculate, or go to a site";
+    let put = () => {
+      if (input.placeholder != text) {
+        input.placeholder = text;
+      }
+    };
+    new MutationObserver(put).observe(input, {
+      attributes: true,
+      attributeFilter: ["placeholder"],
+    });
+    put();
+  },
+
+  get manager() {
+    let { ProvidersManager } = ChromeUtils.importESModule(
+      "moz-src:///browser/components/urlbar/UrlbarProvidersManager.sys.mjs"
+    );
+    return ProvidersManager.getInstanceForSap("urlbar");
+  },
+
+  register() {
+    let manager = this.manager;
+    if (manager.getProvider("VantaSiteSearch")) {
+      return;
+    }
+    let providers = this.makeProviders();
+    for (let provider of providers) {
+      manager.registerProvider(provider);
+    }
+    // Heuristic results are ranked by provider order. Site search only runs
+    // for "<a site you visit> <words>", and then it should win over the
+    // plain web search, so it goes first.
+    let list = manager.providers;
+    list.unshift(...list.splice(list.indexOf(providers[0]), 1));
+    window.addEventListener(
+      "unload",
+      () => {
+        for (let provider of providers) {
+          manager.unregisterProvider(provider);
+        }
+        let next = BrowserWindowTracker.orderedWindows.find(
+          w => w != window && w.VantaSearch
+        );
+        next?.VantaSearch.register();
+      },
+      { once: true }
+    );
+  },
+
+  // Shift+Enter: open the selected result beside this page.
+  handleEvent(event) {
+    if (
+      event.target != gURLBar.inputField ||
+      event.key != "Enter" ||
+      !event.shiftKey ||
+      event.altKey
+    ) {
+      return;
+    }
+    let tab = gBrowser.selectedTab;
+    if (tab.pinned || tab.splitview || !gURLBar.view.isOpen) {
+      return;
+    }
+    let result = gURLBar.view.selectedResult;
+    let url = result?.payload.url;
+    if (!url && result?.payload.engine) {
+      let { SearchService } = ChromeUtils.importESModule(
+        "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+      );
+      let engine = SearchService.getEngineByName(result.payload.engine);
+      url = engine?.getSubmission(result.payload.query || gURLBar.value).uri
+        .spec;
+    }
+    if (!url) {
+      return;
+    }
+    event.preventDefault();
+    event.stopPropagation();
+    gURLBar.view.close();
+    gURLBar.handleRevert();
+    let newTab = gBrowser.addTrustedTab(url, { index: tab._tPos + 1 });
+    gBrowser.addTabSplitView([tab, newTab], { trigger: "vanta_urlbar" });
+    gBrowser.selectedTab = newTab;
+  },
+
+  makeProviders() {
+    const { UrlbarProvider } = ChromeUtils.importESModule(
+      "moz-src:///browser/components/urlbar/UrlbarUtils.sys.mjs"
+    );
+    const { UrlbarResult } = ChromeUtils.importESModule(
+      "chrome://browser/content/urlbar/UrlbarResult.mjs"
+    );
+    const { UrlbarShared } = ChromeUtils.importESModule(
+      "chrome://browser/content/urlbar/UrlbarShared.mjs"
+    );
+    const { SearchService } = ChromeUtils.importESModule(
+      "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+    );
+
+    // Every IANA zone's city, so "time são paulo" or "time reykjavik" work
+    // without a list of our own.
+    let zones = new Map();
+    for (let zone of Intl.supportedValuesOf("timeZone")) {
+      let city = zone.split("/").pop().replace(/_/g, " ").toLowerCase();
+      zones.set(city, zone);
+    }
+    for (let [city, zone] of [
+      ["new york", "America/New_York"],
+      ["san francisco", "America/Los_Angeles"],
+      ["beijing", "Asia/Shanghai"],
+      ["delhi", "Asia/Kolkata"],
+      ["mumbai", "Asia/Kolkata"],
+      ["bergen", "Europe/Oslo"],
+      ["trondheim", "Europe/Oslo"],
+      ["washington", "America/New_York"],
+      ["seattle", "America/Los_Angeles"],
+      ["boston", "America/New_York"],
+    ]) {
+      zones.set(city, zone);
+    }
+
+    let timeAnswer = text => {
+      let m = /^(?:time\s+(?:in\s+)?(.+)|(.+?)\s+time)$/i.exec(text.trim());
+      let city = (m?.[1] || m?.[2])?.toLowerCase();
+      let zone = city && zones.get(city);
+      if (!zone) {
+        return null;
+      }
+      let now = new Date();
+      let time = now.toLocaleTimeString(undefined, {
+        timeZone: zone,
+        hour: "2-digit",
+        minute: "2-digit",
+      });
+      let day = now.toLocaleDateString(undefined, {
+        timeZone: zone,
+        weekday: "long",
+        day: "numeric",
+        month: "long",
+      });
+      let offset = tz => {
+        let parts = new Intl.DateTimeFormat("en-US", {
+          timeZone: tz,
+          timeZoneName: "longOffset",
+        }).formatToParts(now);
+        let name = parts.find(p => p.type == "timeZoneName").value;
+        let [, sign, h, mm] = /GMT(?:([+-])(\d+):?(\d+)?)?/.exec(name) || [];
+        return sign ? (sign == "-" ? -1 : 1) * (+h * 60 + +(mm || 0)) : 0;
+      };
+      let diff =
+        (offset(zone) -
+          offset(Intl.DateTimeFormat().resolvedOptions().timeZone)) /
+        60;
+      let place = city.replace(/\b\w/g, c => c.toUpperCase());
+      let rel =
+        diff == 0
+          ? "same time as you"
+          : `${Math.abs(diff)} h ${diff > 0 ? "ahead of" : "behind"} you`;
+      // Where the sun is there: 0deg at 6:00 (rising), 180deg at 18:00.
+      let [h, mm] = new Intl.DateTimeFormat("en-GB", {
+        timeZone: zone,
+        hour: "2-digit",
+        minute: "2-digit",
+        hourCycle: "h23",
+      })
+        .format(now)
+        .split(":")
+        .map(Number);
+      let angle = ((((h + mm / 60 - 6) / 24) * 360) % 360 + 360) % 360;
+      return { title: time, detail: `${place} · ${day} · ${rel}`, angle };
+    };
+
+    // Sites you visit, by name: "nrk" -> nrk.no.
+    let sites = null;
+    let loadSites = async () => {
+      let rows = await PlacesUtils.withConnectionWrapper(
+        "VantaSearch",
+        db =>
+          db.executeCached(
+            `SELECT host, frecency FROM moz_origins
+             WHERE frecency <> 0 ORDER BY frecency DESC LIMIT 400`
+          )
+      );
+      sites = new Map();
+      for (let row of rows) {
+        let host = row.getResultByName("host");
+        let name;
+        try {
+          let base = Services.eTLD.getBaseDomainFromHost(host);
+          let suffix = Services.eTLD.getPublicSuffixFromHost(host);
+          name = base.slice(0, -suffix.length - 1);
+        } catch (e) {
+          continue;
+        }
+        if (name && !sites.has(name)) {
+          sites.set(name, host.replace(/^www\./, ""));
+        }
+      }
+      setTimeout(() => (sites = null), 10 * 60 * 1000);
+    };
+    let siteSearch = async text => {
+      let m = /^(\S+)\s+(.+)$/.exec(text.trim());
+      if (!m) {
+        return null;
+      }
+      if (!sites) {
+        await loadSites();
+      }
+      let host = sites.get(m[1].toLowerCase());
+      if (!host) {
+        return null;
+      }
+      // The site's own engine when one is installed (Wikipedia, YouTube…),
+      // otherwise your default engine limited to that site.
+      let engine = (await SearchService.getVisibleEngines()).find(e => {
+        try {
+          return e.searchUrlDomain.endsWith(host.split(".").slice(-2).join("."));
+        } catch (ex) {
+          return false;
+        }
+      });
+      let query = m[2];
+      let url = engine
+        ? engine.getSubmission(query).uri.spec
+        : (await SearchService.getDefault()).getSubmission(
+            `site:${host} ${query}`
+          ).uri.spec;
+      return { url, host, query };
+    };
+
+    class VantaAnswers extends UrlbarProvider {
+      get name() {
+        return "VantaAnswers";
+      }
+      get type() {
+        return UrlbarShared.PROVIDER_TYPE.PROFILE;
+      }
+      async isActive(context) {
+        this.answer = timeAnswer(context.searchString);
+        return !!this.answer && !context.restrictInSearchMode?.();
+      }
+      startQuery(context, add) {
+        add(
+          this,
+          new UrlbarResult({
+            type: UrlbarShared.RESULT_TYPE.DYNAMIC,
+            source: UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+            suggestedIndex: 1,
+            payload: { dynamicType: "vantaAnswer", ...this.answer },
+          })
+        );
+      }
+      getViewTemplate() {
+        return {
+          attributes: { selectable: true },
+          children: [
+            {
+              name: "content",
+              tag: "span",
+              classList: ["urlbarView-no-wrap", "vanta-answer"],
+              children: [
+                {
+                  name: "sky",
+                  tag: "span",
+                  classList: ["vanta-answer-sky"],
+                  children: [{ name: "body", tag: "span", classList: ["vanta-answer-body"] }],
+                },
+                { name: "title", tag: "strong", classList: ["vanta-answer-title"] },
+                { name: "detail", tag: "span", classList: ["vanta-answer-detail"] },
+              ],
+            },
+          ],
+        };
+      }
+      getViewUpdate(result) {
+        return {
+          title: { textContent: result.payload.title },
+          detail: { textContent: result.payload.detail },
+          sky: {
+            // At night the moon takes the same arc.
+            style: { "--angle": `${result.payload.angle % 180}deg` },
+            attributes: { night: result.payload.angle > 180 },
+          },
+        };
+      }
+    }
+
+    // Heuristic, so Enter goes to the site's results. Only active when the
+    // first word is the name of a site you visit and more words follow.
+    class VantaSiteSearch extends UrlbarProvider {
+      // For the field's site chip, which can't wait for history.
+      siteFor(name) {
+        if (!sites) {
+          loadSites();
+          return null;
+        }
+        return sites.get(name.toLowerCase());
+      }
+      get name() {
+        return "VantaSiteSearch";
+      }
+      get type() {
+        return UrlbarShared.PROVIDER_TYPE.HEURISTIC;
+      }
+      async isActive(context) {
+        if (
+          context.searchMode ||
+          context.restrictSource ||
+          context.isPrivate ||
+          /^[a-z]+:|\//i.test(context.searchString)
+        ) {
+          return false;
+        }
+        this.found = await siteSearch(context.searchString);
+        return !!this.found;
+      }
+      getPriority() {
+        return 0;
+      }
+      startQuery(context, add) {
+        let { url, host, query } = this.found;
+        add(
+          this,
+          new UrlbarResult({
+            type: UrlbarShared.RESULT_TYPE.URL,
+            source: UrlbarShared.RESULT_SOURCE.OTHER_LOCAL,
+            heuristic: true,
+            payload: {
+              url,
+              title: `Search ${host} for “${query}”`,
+              icon: `page-icon:https://${host}/`,
+            },
+          })
+        );
+      }
+    }
+
+    return [new VantaSiteSearch(), new VantaAnswers()];
+  },
+};
+delayedStartupPromise.then(() => VantaSearch.init());
+
+// Vanta: the new tab. A blank page the window draws on (no extra content
+// process), seamless with the frame: your search set large like a page
+// heading, under the date and tonight's moon, over a planet's horizon lit by
+// the sun for the time of day. As you type, suggestions are set under your
+// words in the same type: searches first, then pages from your history. Opening a tab is a sunrise,
+// played once; afterwards nothing moves. Off with vanta.newtab.home.
+var VantaHome = {
+  PREF: "vanta.newtab.home",
+  HTML: "http://www.w3.org/1999/xhtml",
+
+  init() {
+    if (!Services.prefs.getBoolPref(this.PREF, true)) {
+      return;
+    }
+    AboutNewTab.newTabURL = "about:blank";
+    let el = (tag, cls, ...children) => {
+      let node = document.createElementNS(this.HTML, tag);
+      node.className = cls;
+      node.append(...children);
+      return node;
+    };
+    this.input = el("input", "vanta-home-input");
+    this.input.placeholder = "Search or enter address";
+    this.input.setAttribute("aria-label", this.input.placeholder);
+    this.input.addEventListener("keydown", this);
+    this.input.addEventListener("input", this);
+    this.list = el("ol", "vanta-home-suggestions");
+    this.list.addEventListener("click", this);
+    this.list.addEventListener("mousedown", e => e.preventDefault());
+    this.root = el(
+      "div",
+      "",
+      // The sun first, so the planet hides its lower half.
+      el("div", "vanta-home-sky", el("div", "vanta-home-sun"), el("div", "vanta-home-planet")),
+      el(
+        "div",
+        "vanta-home-search",
+        el(
+          "div",
+          "vanta-home-date",
+          (this.moon = el("span", "vanta-home-moon")),
+          (this.date = el("span", ""))
+        ),
+        this.input,
+        this.list
+      )
+    );
+    this.root.id = "vanta-home";
+    document.getElementById("tabbrowser-tabbox").append(this.root);
+    gBrowser.addTabsProgressListener(this);
+    gBrowser.tabContainer.addEventListener("TabSelect", this);
+    this.update();
+  },
+
+  // A blank tab the user opened, not a page a site opened and writes into.
+  isHome(browser) {
+    return (
+      browser.currentURI.spec == "about:blank" &&
+      !browser.isLoadingDocument &&
+      !browser.browsingContext?.opener &&
+      !browser.hasContentOpener
+    );
+  },
+
+  onLocationChange(browser, webProgress) {
+    if (webProgress.isTopLevel && browser == gBrowser.selectedBrowser) {
+      this.update();
+    }
+  },
+
+  update() {
+    let home = this.isHome(gBrowser.selectedBrowser);
+    let was = document.documentElement.hasAttribute("vanta-home");
+    document.documentElement.toggleAttribute("vanta-home", home);
+    if (!home) {
+      return;
+    }
+    this.sky();
+    if (!was) {
+      // Each arrival is a new sunrise: restart the one-shot animation.
+      this.root.removeAttribute("dawn");
+      this.root.getBoundingClientRect();
+      this.root.setAttribute("dawn", "");
+      this.input.value = "";
+      this.suggest();
+    }
+    // A new tab focuses the address bar; the search bar here takes it.
+    setTimeout(() => {
+      if (
+        document.documentElement.hasAttribute("vanta-home") &&
+        document.activeElement == gURLBar.inputField &&
+        !gURLBar.value
+      ) {
+        this.input.focus();
+      }
+    });
+  },
+
+  // Night, dawn, day or dusk, from the clock; the date; the moon's phase.
+  sky() {
+    let now = new Date();
+    this.date.textContent = now.toLocaleDateString(undefined, {
+      weekday: "long",
+      day: "numeric",
+      month: "long",
+    });
+    // Days into the lunar month, from a known new moon (6 Jan 2000, 18:14
+    // UTC). Waxing is lit from the right, waning from the left.
+    let phase = ((now - Date.UTC(2000, 0, 6, 18, 14)) / 864e5 / 29.530588) % 1;
+    let lit = 1 - Math.abs(1 - 2 * phase);
+    this.moon.style.setProperty(
+      "--moon-shadow",
+      `${(phase < 0.5 ? -1 : 1) * Math.round(14 * (1 - lit))}px`
+    );
+    let h = now.getHours() + now.getMinutes() / 60;
+    this.root.dataset.sky =
+      h < 6 || h >= 20 ? "night" : h < 9 ? "dawn" : h < 17 ? "day" : "dusk";
+  },
+
+  handleEvent(event) {
+    switch (event.type) {
+      case "TabSelect":
+        this.update();
+        break;
+      case "input":
+        clearTimeout(this.typing);
+        this.typing = setTimeout(() => this.suggest(), 60);
+        break;
+      case "click": {
+        let row = event.target.closest("li");
+        if (row) {
+          this.go(this.rows[[...this.list.children].indexOf(row)], event);
+        }
+        break;
+      }
+      case "keydown":
+        this.onKey(event);
+        break;
+    }
+  },
+
+  onKey(event) {
+    let count = this.list.children.length;
+    if ((event.key == "ArrowDown" || event.key == "ArrowUp") && count) {
+      event.preventDefault();
+      let step = event.key == "ArrowDown" ? 1 : -1;
+      // -1 is the words as typed.
+      this.selected = ((this.selected ?? -1) + step + count + 2) % (count + 1) - 1;
+      this.select();
+    } else if (event.key == "Enter" && this.input.value.trim()) {
+      event.preventDefault();
+      this.go(this.rows?.[this.selected ?? -1], event);
+    } else if (event.key == "Escape") {
+      this.input.value = "";
+      this.suggest();
+    }
+  },
+
+  // Enter goes where the address bar would: a site, or your search engine.
+  go(row, event) {
+    if (row?.url) {
+      openTrustedLinkIn(row.url, "current");
+      return;
+    }
+    gURLBar.value = row?.text ?? this.input.value.trim();
+    gURLBar.valueIsTyped = true;
+    gURLBar.handleNavigation({ event });
+  },
+
+  select() {
+    [...this.list.children].forEach((li, i) =>
+      li.toggleAttribute("selected", i == this.selected)
+    );
+    let row = this.rows[this.selected];
+    this.input.value = row?.text ?? this.typed;
+  },
+
+  async suggest() {
+    let typed = this.input.value;
+    let query = typed.trim();
+    this.typed = typed;
+    this.selected = -1;
+    if (!query) {
+      this.rows = [];
+      this.list.replaceChildren();
+      return;
+    }
+    let [searches, pages] = await Promise.all([
+      this.searchSuggestions(query),
+      this.historyMatches(query).catch(() => []),
+    ]);
+    if (this.input.value != typed) {
+      return;
+    }
+    this.rows = [
+      ...searches.slice(0, 4).map(text => ({ text })),
+      ...pages.slice(0, 3),
+    ];
+    this.list.replaceChildren(
+      ...this.rows.map(row => {
+        let li = this.el("li", { class: row.url ? "vanta-home-page" : "vanta-home-term" });
+        if (row.url) {
+          let icon = this.el("img", { src: "page-icon:" + row.url, alt: "" });
+          icon.addEventListener("error", () => icon.remove(), { once: true });
+          li.append(
+            icon,
+            this.el("span", {}, row.title || row.host),
+            this.el("span", { class: "vanta-home-host" }, row.host)
+          );
+        } else {
+          // The words you typed stay dim; what the suggestion adds is lit.
+          let rest = row.text.toLowerCase().startsWith(query.toLowerCase())
+            ? row.text.slice(query.length)
+            : null;
+          li.append(
+            rest === null
+              ? row.text
+              : this.el(
+                  "span",
+                  {},
+                  this.el("span", { class: "vanta-home-typed" }, row.text.slice(0, query.length)),
+                  rest
+                )
+          );
+        }
+        return li;
+      })
+    );
+  },
+
+  async searchSuggestions(query) {
+    try {
+      let { SearchService } = ChromeUtils.importESModule(
+        "moz-src:///toolkit/components/search/SearchService.sys.mjs"
+      );
+      let { SearchSuggestionController } = ChromeUtils.importESModule(
+        "moz-src:///toolkit/components/search/SearchSuggestionController.sys.mjs"
+      );
+      this.controller ??= new SearchSuggestionController();
+      let result = await this.controller.fetch({
+        searchString: query,
+        inPrivateBrowsing: PrivateBrowsingUtils.isWindowPrivate(window),
+        engine: await SearchService.getDefault(),
+        maxLocalResults: 2,
+        maxRemoteResults: 6,
+      });
+      let seen = new Set([query.toLowerCase()]);
+      return [...(result?.local || []), ...(result?.remote || [])]
+        .map(entry => entry.value)
+        .filter(text => text && !seen.has(text.toLowerCase()) && seen.add(text.toLowerCase()));
+    } catch (e) {
+      return [];
+    }
+  },
+
+  // Pages you have visited whose address or title contains the words.
+  async historyMatches(query) {
+    if (PrivateBrowsingUtils.isWindowPrivate(window)) {
+      return [];
+    }
+    let db = await PlacesUtils.promiseDBConnection();
+    let like = "%" + query.replace(/[%_/]/g, "/$&") + "%";
+    let rows = await db.executeCached(
+      `SELECT url, title FROM moz_places
+       WHERE hidden = 0 AND frecency <> 0
+         AND (url LIKE :pattern ESCAPE '/' OR title LIKE :pattern ESCAPE '/')
+       ORDER BY frecency DESC LIMIT 6`,
+      { pattern: like }
+    );
